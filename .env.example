# Variáveis efetivamente lidas até H12. Valores fictícios; nunca versionar o .env real.
# Copie para .env (desenvolvimento) ou .env.hml (homologação) e preencha. Novas variáveis
# (PSP_*, S3_* etc.) entram nas histórias que as usarem.

# --- Aplicação (backend fora do Docker) ---
# Ambiente exibido na tela inicial: development | homologation | production. Opcional (padrão development).
# No Compose é fixado por arquivo: development em compose.dev.yml, homologation em compose.hml.yml.
APP_ENV=development
# Porta HTTP do backend. Opcional (padrão 8080).
SERVER_PORT=8080
# Banco (backend fora do Docker). No Compose são preenchidas a partir das senhas acima.
JDBC_URL=jdbc:postgresql://localhost:5432/fastpay
JDBC_APP_PASSWORD=troque-por-mais-uma-senha-aleatoria
JDBC_MIGRATION_PASSWORD=troque-por-outra-senha-aleatoria
# Opcionais: tamanho do pool (padrão 10) e Flyway no processo web (padrão true; false em produção, H50).
JDBC_POOL_SIZE=10
FLYWAY_ENABLED=true
# Opcional: worker da fila de jobs no processo (padrão true; H04).
JOBS_WORKER_ENABLED=true
# Login e sessão (H08). Cookie de sessão só por HTTPS (padrão true); false apenas em dev acessado por
# IP da rede local sem HTTPS. Navegadores aceitam cookie Secure em http://127.0.0.1 e localhost.
SESSION_COOKIE_SECURE=true
# E-mail (H12). Endereço público do frontend usado nos links (redefinição de senha, convites), sem barra
# final; o token vai no fragmento #token=. Em produção precisa ser https.
PUBLIC_BASE_URL=http://127.0.0.1:8088
# Transporte: caixa-de-teste (padrão; memória, nenhum envio) ou smtp. Produção não aceita caixa-de-teste.
MAIL_TRANSPORT=caixa-de-teste
# Só desenvolvimento local e só com a caixa de teste: expõe as mensagens em /api/v1/dev/caixa-de-teste.
TEST_MAILBOX_ENDPOINT=false
# SMTP (homologação: Gmail dedicado com senha de app; produção: SES, H49). Obrigatórios com MAIL_TRANSPORT=smtp;
# o backend não sobe sem eles. A senha é segredo: só no .env/.env.hml real, nunca no Git.
MAIL_FROM=fastPay HML <conta-de-teste@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=conta-de-teste@gmail.com
SMTP_PASSWORD=troque-pela-senha-de-app
# Destinatários permitidos, separados por vírgula: pessoa@dominio ou @dominio. Fora de produção é obrigatória
# com SMTP; quem estiver fora não recebe (o envio é registrado como bloqueado, sem link criado).
MAIL_ALLOWED_RECIPIENTS=conta-de-teste@gmail.com
# Verificação em duas etapas (H09). Chave AES-256 que cifra o segredo TOTP, guardada fora do banco.
# Obrigatória (também no Compose): 32 bytes aleatórios em Base64, um valor por ambiente, gerado com
# `head -c 32 /dev/urandom | base64`. Trocar a chave invalida os autenticadores já cadastrados.
MFA_ENCRYPTION_KEY=troque-por-32-bytes-aleatorios-em-base64

# --- Compose (infra/compose.dev.yml e infra/compose.hml.yml) ---
# Banco interno, sem porta publicada. Senha obrigatória; gere uma aleatória por ambiente.
POSTGRES_DB=fastpay
POSTGRES_USER=fastpay_owner
POSTGRES_PASSWORD=troque-por-uma-senha-aleatoria
# Papéis criados na primeira inicialização do volume (infra/postgres/init/01-roles.sh, H03):
# fastpay_migration (Flyway, dono do schema) e fastpay_app (runtime, sem BYPASSRLS). Senhas obrigatórias.
# Volume criado antes da H03 não tem esses papéis: em dev, recriar com `down -v` (apaga dados locais).
FASTPAY_MIGRATION_PASSWORD=troque-por-outra-senha-aleatoria
FASTPAY_APP_PASSWORD=troque-por-mais-uma-senha-aleatoria
# Porta local (127.0.0.1) do frontend, que também encaminha /api. Opcional (8088 dev, 8089 HML).
FASTPAY_HTTP_PORT=8088

# --- Somente homologação (compose.hml.yml) ---
# Dono das imagens no GHCR (usuário/organização do repositório GitHub, minúsculas) e tag publicada pela CI.
FASTPAY_IMAGE_OWNER=dono-do-repositorio
FASTPAY_VERSION=sha-0000000000000000000000000000000000000000
