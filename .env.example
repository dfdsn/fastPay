# Variáveis efetivamente lidas pela aplicação até H01. Valores fictícios; nunca versionar o .env real.
# Novas variáveis (JDBC_*, SESSION_*, MAIL_*, PSP_* etc.) entram nas histórias que as usarem.

# Ambiente exibido na tela inicial: development | homologation | production. Opcional (padrão development).
APP_ENV=development

# Porta HTTP do backend. Opcional (padrão 8080).
SERVER_PORT=8080
